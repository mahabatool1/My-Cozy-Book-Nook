rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // Validation Blueprint for Book
    function isValidBook(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'author', 'totalPages', 'currentPage', 'status', 'favorite'])
        // Allow optional fields: rating, notes, coverColor, startedDate, finishedDate, tags, coverUrl, coverImage
        && data.keys().size() >= 8 && data.keys().size() <= 16
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.author is string && data.author.size() > 0 && data.author.size() <= 100
        && data.totalPages is number && data.totalPages >= 0
        && data.currentPage is number && data.currentPage >= 0
        && data.status is string && data.status in ['reading', 'to_read', 'finished']
        && data.favorite is bool
        && (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 5))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && (!('coverColor' in data) || (data.coverColor is string && data.coverColor.size() <= 20))
        && (!('coverUrl' in data) || (data.coverUrl is string && data.coverUrl.size() <= 1000))
        && (!('coverImage' in data) || (data.coverImage is string && data.coverImage.size() <= 1000000))
        && (!('startedDate' in data) || (data.startedDate is string && data.startedDate.size() <= 30))
        && (!('finishedDate' in data) || (data.finishedDate is string && data.finishedDate.size() <= 30))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 15 && (data.tags.size() == 0 || data.tags[0] is string)));
    }

    // Validation Blueprint for ReadingActivity
    function isValidReadingActivity(data) {
      return data.keys().hasAll(['id', 'userId', 'durationSeconds', 'timestamp', 'dateStr'])
        && data.keys().size() >= 5 && data.keys().size() <= 7
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.durationSeconds is number && data.durationSeconds >= 0
        && data.timestamp is string && data.timestamp.size() <= 100
        && data.dateStr is string && data.dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('bookId' in data) || (data.bookId is string && data.bookId.size() <= 128))
        && (!('bookTitle' in data) || (data.bookTitle is string && data.bookTitle.size() <= 200));
    }

    // Books subcollection
    match /users/{userId}/books/{bookId} {
      // User can only access their own subcollection
      allow read, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(bookId)
        && isValidBook(incoming());

      allow update: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(bookId)
        && isValidBook(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;

      allow delete: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(bookId);
    }

    // ReadingActivity subcollection
    match /users/{userId}/readingActivity/{activityId} {
      // User can only access their own subcollection
      allow read, list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() 
        && request.auth.uid == userId 
        && isValidId(activityId)
        && isValidReadingActivity(incoming());

      allow update: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(activityId)
        && isValidReadingActivity(incoming())
        && incoming().userId == existing().userId
        && incoming().id == existing().id;

      allow delete: if isSignedIn() 
        && request.auth.uid == userId
        && isValidId(activityId);
    }
  }
}
